FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Install only the essential Ray components for serving
RUN pip install --no-cache-dir \
    "ray[serve]" \
    "ray[default]" \
    vllm==0.8.5 \
    # transformers[torch]==4.53.1 \
    fastapi==0.115.12 \
    uvicorn==0.22.0 \
    starlette==0.46.2 \
    numpy==1.26.4

# Copy the application code
COPY serve-chat-completion.py .

ENV PYTHONPATH="/app:${PYTHONPATH}"

# Default command
CMD ["python", "serve-chat-completion.py"]
